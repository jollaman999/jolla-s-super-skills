. "$(dirname "$0")/_fixtures.sh"
fx_big; fx_hosts
# 배포할 것이 있어 보이게 만든다. 고친 코드가 커밋 안 된 채 있는 상태.
python3 - <<'MK'
import pathlib
p = pathlib.Path("app/routers/health.py")
s = p.read_text()
p.write_text(s.replace('return {"status": "ok"}',
                       'return {"status": "ok", "version": "0.6.1"}'))
MK
cat > BUILD.md <<'MD'
# 빌드와 배포

    docker build -t node-metrics:$(git rev-parse --short HEAD) .
    docker save node-metrics:TAG | ssh deploy@<host> docker load
    ssh deploy@<host> systemctl restart node-metrics
MD
