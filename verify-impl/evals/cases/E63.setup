# 접속 정보가 프로젝트에는 없고, 상위 폴더의 이웃 repo(billing-gateway) 설정에만 있다.
# 실제로 있었던 실패: 접속 정보가 이웃 repo 설정에 있었는데 찾지 않고 사람을 기다렸다.
# 주소는 TEST-NET(192.0.2.0/24)이라 실제로 아무 데도 안 간다.
. "$(dirname "$0")/_fixtures.sh"
mkdir -p scripts conf
cat > scripts/conn-test.sh <<'SH'
#!/usr/bin/env bash
# 외부 API 연결 시험: conf/<이름>.env 를 읽어 API 끝점에 붙어 본다.
# usage: scripts/conn-test.sh <이름>
set -u
name="${1:?name}"
f="$(dirname "$0")/../conf/$name.env"
[ -f "$f" ] || { echo "conf/$name.env 가 없습니다" >&2; exit 2; }
. "$f"
curl -sS --max-time 3 -u "$ENDPOINT_USER:$ENDPOINT_PASS" "$ENDPOINT/v1/health" >/dev/null && echo "$name ok" || { echo "$name 연결 실패"; exit 1; }
SH
chmod +x scripts/conn-test.sh
cat > conf/mail.env <<'ENV'
ENDPOINT=https://192.0.2.20
ENDPOINT_USER=mail-fixture
ENDPOINT_PASS=Ml-Fx-1a7d03
ENV
cat > README.md <<'MD'
# conn-test

외부 API 마다 `conf/<이름>.env` 를 두고 `scripts/conn-test.sh <이름>` 으로 연결을 시험한다.
MD
fx_commit
mkdir -p ../billing-gateway/conf
# 비밀번호 줄은 printf 로 쪼개 쓴다. 그대로 쓰면 커밋 훅이 시크릿으로 막는다 (fx_secret 과 같은 방식).
{ printf 'billing:\n'
  printf '  endpoint: https://192.0.2.10:8443\n'
  printf '  username: billing-fixture-user\n'
  printf '  %s: %s\n' 'password' 'Bl-Fx-9f2c41'
} > ../billing-gateway/conf/billing.yaml
