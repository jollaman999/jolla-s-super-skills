#!/usr/bin/env bash
# 공개 repo 유출 차단. 스테이지된 내용만 검사한다.
# 설치: ln -sf ../../hooks/pre-commit .git/hooks/pre-commit
# 우회: git commit --no-verify  (정말 필요할 때만)
set -uo pipefail
FAIL=0
red(){ printf '\033[31m%s\033[0m\n' "$*"; }

# 훅 자신은 검사 대상에서 뺀다 - 탐지 패턴이 곧 금지 문자열이라 자기를 차단한다.
# 다른 예외를 추가하려면 정말 필요한지 먼저 따진다.
staged=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '^hooks/pre-commit$')
[ -z "$staged" ] && exit 0

check() { # <라벨> <정규식> <설명>
  local hits
  hits=$(git diff --cached --unified=0 -- $staged 2>/dev/null \
         | grep -nE '^\+' | grep -vE '^\+\+\+' | grep -inE "$2" | head -5)
  if [ -n "$hits" ]; then
    red "차단: $1"
    echo "$hits" | sed 's/^/    /'
    echo "    -> $3"
    FAIL=1
  fi
}

check "비밀번호로 보이는 문자열" \
  '(password|passwd|pw)[\"'"'"' ]*[:=][\"'"'"' ]*[^ \"'"'"',}$#]{6,}' \
  "값을 지우고 env 변수명으로 바꾸세요"

check "JWT 토큰" \
  'eyJ[A-Za-z0-9_-]{15,}\.[A-Za-z0-9_-]{15,}' \
  "토큰 원문을 지우세요"

check "GitHub 토큰" \
  '(gho_|ghp_|ghs_|github_pat_)[A-Za-z0-9_]{20,}' \
  "즉시 해당 토큰을 폐기하세요"

check "AWS 액세스 키" \
  'AKIA[0-9A-Z]{16}' \
  "즉시 키를 폐기하세요"

check "개인키" \
  'BEGIN [A-Z ]*PRIVATE KEY' \
  "키 파일은 커밋하지 않습니다"

check "사내 도메인/조직명" \
  '(innogrid|tabcloudit|o11y-manager|o11y-infra|jollaman999@|ish@)' \
  "일반 예시 이름으로 바꾸세요"

# 사설/공인 IP - 문서용 대역은 허용
ips=$(git diff --cached --unified=0 -- $staged 2>/dev/null \
      | grep -E '^\+' | grep -vE '^\+\+\+' \
      | grep -hoE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u \
      | grep -vE '^(0\.0\.0\.0|127\.0\.0\.1|255\.255\.255\.255|192\.0\.2\.[0-9]+|198\.51\.100\.[0-9]+|203\.0\.113\.[0-9]+|10\.0\.[0-9]+\.[0-9]+|1\.2\.3\.4)$')
if [ -n "$ips" ]; then
  red "차단: 문서용이 아닌 IP"
  echo "$ips" | sed 's/^/    /'
  echo "    -> RFC1918(10.0.x.x) 또는 TEST-NET(192.0.2.x / 198.51.100.x / 203.0.113.x) 으로 바꾸세요"
  FAIL=1
fi

# em dash
if git diff --cached --unified=0 -- $staged 2>/dev/null | grep -E '^\+' | grep -vE '^\+\+\+' | grep -q '—'; then
  red "차단: em dash(—) 사용"
  echo "    -> 하이픈(-)으로 바꾸세요"
  FAIL=1
fi

# 접속 대상 파일
if echo "$staged" | grep -qE '(^|/)\.claude/verify-targets\.md$|(^|/)\.claude/verify-progress\.md$'; then
  red "차단: 접속 대상/진행 상태 파일은 커밋하지 않습니다"
  FAIL=1
fi

if [ $FAIL -ne 0 ]; then
  echo
  red "커밋을 중단했습니다. 위 항목을 고친 뒤 다시 커밋하세요."
  echo "정말 의도한 것이면: git commit --no-verify"
  exit 1
fi
exit 0
