#!/usr/bin/env bash
# 커밋 유출 차단. 스테이지된 내용만 검사한다.
# jolla-skills-hook  (install-hooks.sh 가 이 표식으로 자기 것을 알아본다. 지우지 말 것)
# 설치: hooks/install-hooks.sh <repo>
# 우회: git commit --no-verify  (정말 필요할 때만)
#
# 프로필 - repo 의 .git/hooks/.profile 파일 또는 HOOK_PROFILE 로 지정
#   public  : 시크릿 + 내부 조직명 + 사설/공인 IP 전부 차단 (공개 repo)
#   private : 시크릿(비밀번호·토큰·키)만 차단 (사내/비공개 repo)
# em dash 는 프로필과 무관하게 항상 차단한다.
# 미지정이면 remote 주소로 자동 판별하고, 애매하면 private 로 간다 (오탐 최소화).
set -uo pipefail
FAIL=0

GITDIR=$(git rev-parse --git-dir 2>/dev/null || echo .git)
PROFILE="${HOOK_PROFILE:-}"
if [ -z "$PROFILE" ] && [ -f "$GITDIR/hooks/.profile" ]; then
  PROFILE=$(tr -d '[:space:]' < "$GITDIR/hooks/.profile")
fi
# 프로필이 안 적혀 있으면 private 로 간다.
# 공개 여부 판별은 설치 시점(install-hooks.sh)에 gh 로 정확히 하고 .profile 에 적는다.
# 훅에서 매번 판별하면 느리고, GitHub 비공개 repo 를 public 으로 오판해 정상 커밋을 막는다.
[ -z "$PROFILE" ] && PROFILE=private
red(){ printf '\033[31m%s\033[0m\n' "$*"; }

# 훅 자신은 검사 대상에서 뺀다 - 탐지 패턴이 곧 금지 문자열이라 자기를 차단한다.
# 다른 예외를 추가하려면 정말 필요한지 먼저 따진다.
#
# 파일 목록은 NUL 로 받아 배열에 담는다. 줄바꿈으로 받아 따옴표 없이 넘기면
# "my file.txt" 같은 이름이 두 조각으로 쪼개져 git 이 그 파일을 못 찾고,
# diff 가 비어서 검사가 통째로 빗나간다. 시크릿이 그대로 커밋된다.
STAGED=()
while IFS= read -r -d '' f; do
  case "$f" in hooks/pre-commit|hooks/commit-msg) continue ;; esac
  STAGED+=("$f")
done < <(git diff --cached --name-only -z --diff-filter=ACM)
[ ${#STAGED[@]} -eq 0 ] && exit 0

# 남의 코드를 그대로 들여온 파일. 아래 검사 대부분은 "우리가 쓴 글" 에 대한
# 규칙이라, 압축된 남의 번들에 대고 돌리면 잡는 것보다 헛것이 많다.
# swagger-ui 번들이 `_password=()=>"********"` 라는 마스킹 함수를 들고 있어서
# npm 토큰 규칙에 걸린 것이 그 예다. 그 줄을 고칠 수도 없다 - 받은 파일의 해시를
# 대조해서 쓰는 것이라 한 글자만 달라도 대조가 깨진다.
#
# 목록은 아래 셋을 순서대로 읽어 합친다. 한 줄에 경로 정규식 하나,
# '#' 로 시작하는 줄과 빈 줄은 무시한다.
#
#   1) HOOK_VENDORED             파일 경로 (테스트·CI 용)
#   2) $GITDIR/hooks/.vendored   이 repo 전용, 커밋되지 않음
#   3) <repo>/.claude/hook-vendored   이 repo 전용, 커밋되어 팀원에게도 적용
#
# 3번은 조직명 목록과 달리 커밋되는 자리에 둔다. 적히는 것이 경로일 뿐
# 감출 것이 없고, 같은 파일을 받는 사람마다 훅이 다르게 굴면 안 되기 때문이다.
#
# **개인키 검사는 이 목록과 무관하게 전부에 돈다.** PEM 헤더는 형태가 확실해
# 남의 번들이 우연히 만들어 낼 수 없고, 남의 파일에 개인키가 들어 있는 것이야말로
# 걸러야 하는 것이다.
TOPDIR=$(git rev-parse --show-toplevel 2>/dev/null)

VENDOR_FILES=()
[ -n "${HOOK_VENDORED:-}" ] && VENDOR_FILES+=("$HOOK_VENDORED")
[ -f "$GITDIR/hooks/.vendored" ] && VENDOR_FILES+=("$GITDIR/hooks/.vendored")
[ -n "$TOPDIR" ] && [ -f "$TOPDIR/.claude/hook-vendored" ] \
  && VENDOR_FILES+=("$TOPDIR/.claude/hook-vendored")

VENDOR_RE=""
if [ ${#VENDOR_FILES[@]} -gt 0 ]; then
  VENDOR_RE=$(cat "${VENDOR_FILES[@]}" 2>/dev/null \
              | sed 's/[[:space:]]*$//' \
              | grep -vE '^[[:space:]]*(#|$)' \
              | paste -sd '|' -)
fi

# SOURCE 는 우리가 쓴 파일. 대부분의 검사가 이것을 본다.
# STAGED 는 그대로 남는다 - 개인키 검사와 파일 이름으로 거는 검사가 그것을 쓴다.
SOURCE=()
SKIPPED=()
for f in "${STAGED[@]}"; do
  if [ -n "$VENDOR_RE" ] && printf '%s' "$f" | grep -qE "$VENDOR_RE"; then
    SKIPPED+=("$f")
  else
    SOURCE+=("$f")
  fi
done

# 무엇을 안 봤는지 말한다. 조용히 건너뛰면 통과와 구별이 안 된다.
if [ ${#SKIPPED[@]} -gt 0 ]; then
  echo "  (알림: 들여온 파일이라 내용 검사에서 뺍니다. 개인키 검사는 그대로 돕니다)"
  printf '%s\n' "${SKIPPED[@]}" | sed 's/^/           /'
fi

# 검사가 볼 파일. 기본은 우리가 쓴 것 전부다.
# 비밀번호 검사만 이 배열을 갈아 끼워 파일 종류별로 나눠 본다 (아래 참조).
SCOPE=("${SOURCE[@]}")

# 들여온 파일밖에 없으면 내용 검사는 볼 것이 없다. 빈 배열을 git 에 넘기면
# 경로 제한이 통째로 빠져서 스테이지된 것 전부를 보게 된다 - 뺀 것이 도로 들어온다.
if [ ${#SOURCE[@]} -eq 0 ]; then
  SOURCE_EMPTY=1
else
  SOURCE_EMPTY=0
fi

check() { # <라벨> <정규식> <설명> [제외정규식]
  local hits
  # 볼 파일이 없으면 여기서 끝낸다. 빈 배열을 git 에 넘기면 경로 제한이 없는
  # diff 가 되어, 일부러 뺀 파일을 도로 보게 된다.
  [ ${#SCOPE[@]} -eq 0 ] && return 0
  hits=$(git diff --cached --unified=0 -- "${SCOPE[@]}" 2>/dev/null \
         | grep -nE '^\+' | grep -vE '^\+\+\+' | grep -inE "$2" | head -5)
  # 제외정규식이 있으면 거기 걸리는 줄은 뺀다. 값이 리터럴이 아니라
  # 코드 참조인 경우를 걸러내려는 것이지, 탐지를 느슨하게 하려는 것이 아니다.
  if [ -n "${4:-}" ]; then
    hits=$(printf '%s' "$hits" | grep -ivE "$4" | head -5)
  fi
  if [ -n "$hits" ]; then
    red "차단: $1"
    echo "$hits" | sed 's/^/    /'
    echo "    -> $3"
    FAIL=1
  fi
}

# 값이 코드 참조인 줄은 뺀다.
#   Password: v.GetString("myapp.password")       <- 수신자를 거친 호출
#   password: cfg.Password,                       <- Go 필드 접근 (점 뒤가 대문자)
# 둘 다 리터럴이 아니다. 반대로 password=abc.def.ghi 처럼 점이 든 실제 값은
# 점 뒤가 소문자이고 괄호도 없으므로 계속 걸린다.
CODE_REF='[:=][\"'"'"' ]*[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*\(|\.[A-Z][A-Za-z0-9_]*[,)]?$)'

# 값이 가짜임을 그 줄에 적어 두면 비밀번호 검사만 넘긴다. 테스트 픽스처가 이것이다.
# --no-verify 와 다른 점은 나머지 검사가 그대로 돈다는 것이다.
# 토큰·키 검사에는 안 건다 - 형태가 확실해 오탐이 거의 없고, 넘길 길을 열어 두면
# 진짜로 유출된 토큰이 주석 한 줄로 통과한다.
ALLOW='hook:allow'

# 꺾쇠 자리표시자는 값이 아니라 "여기에 네 값을 넣어라" 는 표시다. 문서의 예제와
# 명령줄 사용법이 쓰는 보편적인 표기라서, 이것까지 막으면 README 의 코드 블록에
# hook:allow 주석을 넣게 되고 그 주석이 독자에게 그대로 보인다.
#   -d '{"password":"<your-password>"}'
#   --password <PASSWORD>
# 값 전체가 꺾쇠로 감싸인 경우만 뺀다. <a>bc 처럼 뒤에 뭔가 붙으면 계속 걸린다.
# 꺾쇠 안은 무엇이든 받는다. 한글 문서가 <비밀번호> 라고 쓰는 것이 영어 문서가
# <your-password> 라고 쓰는 것과 같은 일이라서다. 진짜 비밀번호가 꺾쇠로 통째로
# 감싸여 커밋되는 일은 없다.
PLACEHOLDER='[:=][\"'"'"' ]*<[^<>]+>([\"'"'"',;}) ]|$)'

# 비밀번호 검사는 파일 종류로 가른다.
# 프로그래밍 언어 소스에서 : 나 = 뒤에 따옴표 없이 오는 값은 식별자라 비밀번호일 수 없다.
#   Password:    password,        <- 구조체 필드에 변수 대입 (Go)
#   host.Password = password
#   body.password = values.password;   <- 속성 대입 (JS)
# 그래서 아래 확장자에서는 따옴표(" ' `)로 감싼 값만 본다.
# const dbPassword = "abc123" 같은 진짜 리터럴은 그대로 걸린다.
#
# 셸(.sh/.bash/.zsh)은 여기 넣지 않는다. PASSWORD=hunter2 처럼 따옴표 없는 값이
# 곧 실제 비밀번호라서다. yaml·env·ini·properties 도 같은 이유로 제외한다.
CODE_FILES=()
ETC_FILES=()
for f in "${SOURCE[@]}"; do
  case "$f" in
    *.go|*.js|*.mjs|*.cjs|*.ts|*.tsx|*.jsx|*.java|*.kt|*.kts|*.rs|*.py|*.rb|\
    *.c|*.h|*.cc|*.cpp|*.hpp|*.cs|*.swift|*.scala|*.dart)
      CODE_FILES+=("$f") ;;
    *)
      ETC_FILES+=("$f") ;;
  esac
done

if [ ${#CODE_FILES[@]} -gt 0 ]; then
  SCOPE=("${CODE_FILES[@]}")
  check "비밀번호로 보이는 문자열" \
    '(password|passwd|pw)[\"'"'"'` ]*[:=][[:space:]]*[\"'"'"'`][^ \"'"'"'`,}$#]{6,}' \
    "값을 지우고 env 변수명으로 바꾸세요" \
    "$CODE_REF|$ALLOW|$PLACEHOLDER"
fi

if [ ${#ETC_FILES[@]} -gt 0 ]; then
  SCOPE=("${ETC_FILES[@]}")
  check "비밀번호로 보이는 문자열" \
    '(password|passwd|pw)[\"'"'"' ]*[:=][\"'"'"' ]*[^ \"'"'"',}$#]{6,}' \
    "값을 지우고 env 변수명으로 바꾸세요" \
    "$CODE_REF|$ALLOW|$PLACEHOLDER"
fi
SCOPE=("${SOURCE[@]}")

check "JWT 토큰" \
  'eyJ[A-Za-z0-9_-]{15,}\.[A-Za-z0-9_-]{15,}' \
  "토큰 원문을 지우세요"

check "GitHub 토큰" \
  '(gho_|ghp_|ghs_|github_pat_)[A-Za-z0-9_]{20,}' \
  "즉시 해당 토큰을 폐기하세요"

check "AWS 액세스 키" \
  'AKIA[0-9A-Z]{16}' \
  "즉시 키를 폐기하세요"

# npm/yarn 레지스트리 자격증명. .npmrc 에 실제 토큰이 커밋된 사례가 있었다.
check "npm 레지스트리 토큰" \
  '_(authToken|auth|password)[[:space:]]*=[[:space:]]*[^[:space:]$#{]{8,}' \
  "값을 지우고 \${NPM_TOKEN} 같은 env 참조로 바꾸세요"

check "GitLab 토큰" \
  '(glpat-|glptt-|gldt-)[A-Za-z0-9_-]{15,}' \
  "즉시 해당 토큰을 폐기하세요"

# URL 에 박힌 자격증명. git remote, pip index-url, DB DSN 에서 흔하다.
check "URL 에 박힌 자격증명" \
  '://[A-Za-z0-9._%+-]+:[^[:space:]@/\"'"'"']{4,}@' \
  "자격증명을 URL 에서 빼고 env 나 인증 파일로 옮기세요"

# 개인키만 스테이지된 전부를 본다. 들여온 파일도 포함이다.
# PEM 헤더는 형태가 확실해 압축된 코드가 우연히 만들어 낼 수 없고, 남이 만든
# 파일에 키가 들어 있는 것이야말로 여기서 걸러야 하는 것이다.
SCOPE=("${STAGED[@]}")
check "개인키" \
  'BEGIN [A-Z ]*PRIVATE KEY' \
  "키 파일은 커밋하지 않습니다"
SCOPE=("${SOURCE[@]}")

# 사내 조직·제품명은 **소스에 적지 않는다.**
# 차단하려는 이름을 차단하는 코드에 박아 두면, 이 훅이 공개 repo 에 올라가는 순간
# 그 이름이 같이 나간다. 그래서 목록은 커밋되지 않는 곳에서 읽는다.
#
#   1) HOOK_ORG_PATTERNS      파일 경로 (테스트·CI 용)
#   2) $GITDIR/hooks/.org-patterns   이 repo 전용. .git 안이라 커밋되지 않는다
#   3) ~/.claude/hook-org-patterns   전 repo 공통
#
# 형식: 한 줄에 정규식 하나. '#' 로 시작하는 줄과 빈 줄은 무시한다.
#   innogrid
#   (^|[^-])o11y-manager        <- 부분 문자열 오탐을 막으려면 직접 경계를 준다
if [ "$PROFILE" = public ]; then
  ORG_FILES=()
  [ -n "${HOOK_ORG_PATTERNS:-}" ] && ORG_FILES+=("$HOOK_ORG_PATTERNS")
  [ -f "$GITDIR/hooks/.org-patterns" ] && ORG_FILES+=("$GITDIR/hooks/.org-patterns")
  ORG_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hook-org-patterns"
  [ -f "$ORG_HOME" ] && ORG_FILES+=("$ORG_HOME")

  ORG_RE=""
  if [ ${#ORG_FILES[@]} -gt 0 ]; then
    ORG_RE=$(cat "${ORG_FILES[@]}" 2>/dev/null \
             | sed 's/[[:space:]]*$//' \
             | grep -vE '^[[:space:]]*(#|$)' \
             | paste -sd '|' -)
  fi

  if [ -n "$ORG_RE" ]; then
    check "사내 조직·제품명" "($ORG_RE)" \
      "일반 예시 이름으로 바꾸세요. 공개 모듈명이면 목록의 경계 조건을 손보세요"
  else
    # 조용히 건너뛰지 않는다. 검사가 안 도는 것을 통과로 읽으면 그게 무음 실패다.
    echo "  (알림: 사내 이름 목록이 없어 그 검사는 건너뜁니다 -> $ORG_HOME)"
  fi
fi

# 사설/공인 IP - 문서용 대역은 허용. public 프로필만.
# 넷마스크도 허용한다. 255.x.x.x 는 240.0.0.0/4 예약 대역이라 호스트 주소가 될 수 없고,
# 128/192/224/240/248/252/254.0.0.0 은 /1~/7 마스크 값이다. IP 유틸리티의 테스트가
# 넷마스크 리터럴 없이 쓰일 수 없어서 오탐이 난다.
# 사설 대역은 10.x 도 172.16~31.x 도 192.168.x 도 전부 막는다. 셋 다 누군가의
# 사내망 주소라서, 가짜로 쓴 것과 진짜가 들어온 것을 훅이 구분할 수 없다.
# 가짜 주소가 필요하면 TEST-NET(RFC 5737)을 쓴다. 그 셋은 문서용으로 예약돼
# 실제 네트워크가 될 수 없어서, 진짜가 섞여 들어올 일이 없다.
# 루프백 127.0.0.0/8 은 통과시킨다. 그 머신 밖으로 나가지 않아 사내망 주소를
# 흘릴 수가 없고, 테스트가 127.0.0.2 같은 주소로 붙으면 연결이 즉시 거부돼
# 빠르다. 문서용 대역은 응답이 없어 타임아웃까지 기다린다.
if [ "$PROFILE" = public ] && [ "$SOURCE_EMPTY" -eq 0 ]; then
ips=$(git diff --cached --unified=0 -- "${SOURCE[@]}" 2>/dev/null \
      | grep -E '^\+' | grep -vE '^\+\+\+' \
      | grep -hoE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u \
      | grep -vE '^(0\.0\.0\.0|127\.[0-9]+\.[0-9]+\.[0-9]+|192\.0\.2\.[0-9]+|198\.51\.100\.[0-9]+|203\.0\.113\.[0-9]+|1\.2\.3\.4)$' \
      | grep -vE '^(255\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|(128|192|224|240|248|252|254)\.0\.0\.0)$')
if [ -n "$ips" ]; then
  red "차단: 문서용이 아닌 IP"
  echo "$ips" | sed 's/^/    /'
  echo "    -> TEST-NET(192.0.2.x / 198.51.100.x / 203.0.113.x) 이나 루프백(127.x.x.x) 으로 바꾸세요"
  echo "       사설 대역(10.x / 172.16~31.x / 192.168.x)도 막습니다. 누군가의 사내망 주소라서,"
  echo "       가짜로 쓴 것과 진짜가 들어온 것을 구분할 수 없습니다"
  echo "       (넷마스크 255.x.x.x 와 128~254.0.0.0 은 허용됩니다)"
  FAIL=1
fi
fi

# em dash - 프로필 무관. 시크릿이 아니라 표기 규칙이라 공개/비공개가 갈릴 이유가 없다.
if [ "$SOURCE_EMPTY" -eq 0 ] && git diff --cached --unified=0 -- "${SOURCE[@]}" 2>/dev/null | grep -E '^\+' | grep -vE '^\+\+\+' | grep -q '—'; then
  red "차단: em dash(—) 사용"
  echo "    -> 하이픈(-)으로 바꾸세요"
  FAIL=1
fi

# 내 홈 경로와 이 repo 의 절대경로 - 프로필 무관. 사람마다 다른 값이라
# 남의 환경에서 의미가 없고, 공개 repo 면 계정명이 그대로 나간다.
# 조직명 검사와 같은 이유로 값을 여기 적지 않는다 - 실행할 때 알아낸다.
# 문서에서 쓰는 ~/.claude/... 같은 물결표 표기는 걸리지 않는다.
esc_re() { printf '%s' "$1" | sed 's/[][\.*^$\/&]/\\&/g'; }
QUOTE=$(printf '\047')
BOUND="(/|[\"$QUOTE ,);]|$)"
for d in "$HOME" "$TOPDIR"; do
  [ -n "$d" ] && [ "$d" != "/" ] || continue
  check "박힌 절대경로" "$(esc_re "$d")$BOUND" \
    "물결표(~) 나 상대경로로 바꾸세요"
done

# 접속 대상 파일
if printf '%s\n' "${STAGED[@]}" | grep -qE '(^|/)\.claude/verify-targets\.md$|(^|/)\.claude/verify-progress\.md$'; then
  red "차단: 접속 대상/진행 상태 파일은 커밋하지 않습니다"
  FAIL=1
fi

# 셸 스크립트는 shellcheck 로 한 번 더 본다. 없으면 조용히 넘어간다.
# error 급만 막는다. warning 까지는 shared/scripts/lint-shell.sh 로 사람이 본다.
# 스테이지된 조각이 아니라 워킹트리의 파일 전체를 본다 - 문법 검사는 조각으로는 못 한다.
if command -v shellcheck >/dev/null; then
  SHFILES=()
  for f in "${SOURCE[@]}"; do
    case "$f" in *.sh) SHFILES+=("$f"); continue ;; esac
    head -c 40 "$f" 2>/dev/null | head -1 \
      | grep -qE '^#!.*[ /](bash|sh|dash|ksh)( |$)' && SHFILES+=("$f")
  done
  if [ "${#SHFILES[@]}" -gt 0 ]; then
    shout=$(shellcheck -S error -- "${SHFILES[@]}" 2>&1)
    if [ -n "$shout" ]; then
      red "차단: 셸 스크립트 오류"
      echo "$shout" | head -20 | sed 's/^/    /'
      echo "    -> shared/scripts/lint-shell.sh 로 전부 보세요"
      FAIL=1
    fi
  fi
fi

# 규칙 파일을 고쳤으면 회귀를 돌려볼 것을 알린다. 막지는 않는다.
# 검증은 세션을 띄우므로 시간과 토큰이 든다. 돌릴지는 사람이 정한다.
# evals 가 있는 repo(= 이 skills repo)에서만 뜬다.
if printf '%s\n' "${STAGED[@]}" | grep -qE '(^|/)(CLAUDE\.md|SKILL\.md)$'; then
  RUNNER="$TOPDIR/verify-impl/evals/run.sh"
  if [ -x "$RUNNER" ]; then
    QUICK=""
    [ -f "$TOPDIR/verify-impl/evals/quick.txt" ] \
      && QUICK=$(tr -d '\n' < "$TOPDIR/verify-impl/evals/quick.txt")
    echo
    echo "[알림] 규칙 파일을 고쳤습니다:"
    printf '%s\n' "${STAGED[@]}" | grep -E '(^|/)(CLAUDE\.md|SKILL\.md)$' | sed 's/^/         /'
    if [ -n "$QUICK" ]; then
      echo "       verify-impl/evals/run.sh $QUICK"
      echo "       명령·도구로 판정하는 것들입니다. 케이스당 3분쯤 걸립니다."
    else
      echo "       verify-impl/evals/README.md 를 보세요."
    fi
    echo "       돌릴지는 직접 정하세요. 커밋은 그대로 됩니다."
  fi
fi

if [ $FAIL -ne 0 ]; then
  echo
  echo "  (프로필: $PROFILE)"
  red "커밋을 중단했습니다. 위 항목을 고친 뒤 다시 커밋하세요."
  echo "정말 의도한 것이면: git commit --no-verify"
  exit 1
fi
exit 0
